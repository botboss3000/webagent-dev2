data/config/jwt_secret.txt
data/config/auth_revocation.sqlite*
db_connection.json
/db_mode.json
app/auth/users.json
app/auth/users.json.bak
app/db_mode.json
app/db_connection.json
app/secrets_mode.json
app/secrets_config.json
app/secrets_token_fallback.json
app/encryption_mode.json
app/db_encryption.json
app/db_hybrid.json
app/pages_mode.json
app/attachments_store_config.json
# Remote Access (per-machine config + the signpost directory written at runtime)
remote_access.json
remote_access.json.bak
remote_access_pointers.json
# Tunnel Link (relay registration creds written at runtime)
data/config/tunnel_link.json

# FUSE / SSHFS temp leftovers
app/db/.fuse_hidden*
**/.fuse_hidden*

# Visuals user-generated artifacts (moved under data/)
data/visuals/users/

# Runtime backup files created by write_source tool
*.bak

# Uploads + visuals (runtime artifacts now live under data/)
data/uploads/*
!data/uploads/.gitkeep
data/visuals/

# Per-user data home — agent outputs + screenshots saved per user at runtime
# (data/user_data/<user_id>/{files,screenshots,...}). Tracked, except: the admin
# SQLite DB, the admin credentials vault (OAuth tokens + inline secrets), and the
# live Chrome profile (cookies/stored logins — never commit). SQLite
# WAL/SHM/journal sidecars are transient (they vanish mid-write and break
# `git add`) — never tracked.
data/user_data/admin/admin.db
data/user_data/admin/admin.vault.db
data/user_data/admin/chrome-profile/
data/user_data/**/*.db-wal
data/user_data/**/*.db-shm
data/user_data/**/*.db-journal
# Agent-owned credential vaults are runtime secrets. The hyphenated names are
# used by agent/member authority workspaces; include SQLite sidecars via `*`.
data/agent_data/**/*.agent-secrets.db*
data/agent_data/**/members/**/*.user-secrets.db*
# Agent authority databases are intentionally versioned, but SQLite creates
# transient companions while they are open.  They can disappear during
# `git add -A`, so never let Git traverse/index them.
data/agent_data/**/*.db-wal
data/agent_data/**/*.db-shm
data/agent_data/**/*.db-journal
# Browser-tool screenshots — runtime output (legacy/fallback pile). The per-user
# home above is the new destination; this dir stays only as a fallback. Never tracked.
data/screenshots/

# Scratch / backup / PID files — kept on disk, never tracked
.source-backups/
.update-backups/
tmp/
bg_pid.txt
TUI/server.pid
TUI/self-update/
# TUI's local runtime config holds its own API key — keep it out of git.
TUI/config.json

# Launcher build output: the single portable webagent.exe now lands at the
# PROJECT ROOT (built from launcher/ via launcher/scripts/build_exe.py).
# Scratch build dirs stay under launcher/. None of these are committed.
/webagent.exe
launcher/*.exe
launcher/*snapshot*.svg
launcher/assets/webagent.ico
launcher/assets/webagent_256.png
launcher/dist/
launcher/build/

# launcher_android runtime bridge file (Browser button host↔proot)
launcher_android/.browser-bridge
.git-rewrite/
  
cookies.txt

# Pre-admin-rename DB backup (kept on disk, never committed — contains 166MB+ DBs)
data/db.bak-pre-admin-rename/

# DB backup embeds (*.bak-embed) — can exceed GitHub's 100 MB file limit
*.bak-embed

# RECORDER-HOOK: diagnostic archive, scopes and worker state are runtime data.
data/recorder/
