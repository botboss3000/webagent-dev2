# ── Runtime databases (now under data/db/) ──────────────────────────────────
# All runtime DB *files* live in data/db/ (the app's stored state); the DB *code*
# stays in app/db/. Covers app.db, logs.db, recordings.db, vault.db, tests.db,
# and the optimizer/closer scratch DBs + their WAL/SHM/journal sidecars.
data/db/
data/cache/
data/instance/

# Company-wide Wiki: the wiki.db file itself IS tracked (committed to the repo),
# but its transient SQLite sidecars are not — they only exist mid-write.
data/wiki.db-journal
data/wiki.db-wal
data/wiki.db-shm

# ── Browser profile (local-Chrome feature) ──────────────────────────────────
# The entire on-disk Chrome profile is runtime state: cookies, trust tokens,
# caches, and Chrome's own databases. Never commit it — it churns constantly,
# bloats the repo, and contains session data.
data/chrome-profile/

# ── Stray / scratch databases & dumps (runtime, never tracked) ──────────────
# Root-level stray DB, the TUI's runtime DB, and ad-hoc DB dumps.
webagent.db
TUI/webagent.db
_dbdump.txt

# Dedicated, always-local logs databases (server diagnostics + browser render
# recorder) and the per-box instance id. Runtime artifacts — see app/db/logs_store.py.
app/db/logs.db
app/db/logs.db-journal
app/db/logs.db-wal
app/db/logs.db-shm
app/db/recordings.db
app/db/recordings.db-journal
app/db/recordings.db-wal
app/db/recordings.db-shm
app/db/instance_id.txt

# Dedicated credentials "vault" DB (auth_elements — integration OAuth tokens +
# inline secret values), kept out of the user-data DB so a reset is non-destructive.
app/db/vault.db
app/db/vault.db-journal
app/db/vault.db-wal
app/db/vault.db-shm

# Per-user runtime "closer" DBs (created by the running app)
app/db/closer_*.db
app/db/closer_*.db-journal
app/db/closer_*.db-wal
app/db/closer_*.db-shm

# Optimizer runtime temp DBs (worker trials + planner sessions)
app/db/test_*.db
app/db/test_*.db-journal
app/db/test_*.db-wal
app/db/test_*.db-shm
data/db/optimizer.db
data/db/optimizer.db-journal
data/db/optimizer.db-wal
data/db/optimizer.db-shm

# Per-machine runtime artifacts (Android/proot etc.)
.proot.pid
start_server_proot.sh

