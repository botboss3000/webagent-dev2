{
  "version": 3,
  "description": "Chat presentation defaults. chat_common is the shared base; each chat_* surface overrides only the values it needs.",
  "agents_page_widget": {
    "description": "Shared Agents-page Ask or Search launcher. It expands in place, forwards live text to whichever Agents sub-view search control is on screen (the Agents/Abilities search, or the embedded Sessions view's footer search \u2014 title + content with per-session hit counts), and sends questions through the normal WebAgent widget with current page context. On the Sessions sub-view the pill is search-only (no chat): it advertises a 'Search for a session' label and its trailing control becomes a red clear/collapse button (search_clear_* and search_collapse_* below) \u2014 it empties the field, or collapses the pill when the field is already empty, because the filter already runs as the user types.",
    "enabled": true,
    "title": "WebAgent",
    "icon": "bot",
    "label": "Ask or Search",
    "aria_label": "Ask WebAgent or search agents and abilities",
    "tooltip": "Ask WebAgent or search agents and abilities",
    "input_placeholder": "Ask or search",
    "search_label": "Search for a session",
    "search_placeholder": "Search for a session",
    "search_tooltip": "Searches as you type",
    "search_icon": "search",
    "search_clear_label": "Clear search",
    "search_clear_tooltip": "Clear search",
    "search_clear_icon": "x",
    "search_collapse_label": "Collapse search",
    "search_collapse_tooltip": "Collapse search",
    "default_side": "right",
    "edge_offset": 16,
    "bottom_offset": 16
  },
  "settings_page_widget": {
    "description": "Shared Settings-page Ask or Search launcher. Replaces the old in-page composer pill: it expands in place, forwards live text to the Settings search engine, and sends questions through the normal WebAgent widget with the current settings page/section as context.",
    "enabled": true,
    "title": "WebAgent",
    "icon": "bot",
    "label": "Ask or Search",
    "aria_label": "Ask WebAgent or search app settings",
    "tooltip": "Ask WebAgent or search app settings",
    "input_placeholder": "Search settings or ask how to configure something",
    "default_side": "right",
    "edge_offset": 16,
    "bottom_offset": 16
  },
  "tier_gates": {
    "description": "Server-authoritative capability gates for the complete chat UI document. The server removes this block, resolves subject/tier overlays, and forces denied controls off after per-agent overrides. Requirements use named capabilities rather than tier rank so custom tiers work correctly.",
    "requires": {
      "features": [
        "chat"
      ]
    },
    "controls": {
      "model_changer": {
        "features": [
          "model_picker"
        ]
      },
      "storage_mode": {
        "features": [
          "user_byod"
        ]
      },
      "sub_agent_tabs": {
        "ability_groups": [
          "agent_orchestration"
        ]
      },
      "local_changes": {
        "ability_groups": [
          "developer_write"
        ]
      },
      "message_id": {
        "admin_only": true
      },
      "agent_id": {
        "admin_only": true
      },
      "session_id": {
        "admin_only": true
      },
      "engine_thread_id": {
        "admin_only": true
      }
    },
    "subjects": {},
    "tiers": {
      "anonymous": {
        "chat_common": {
          "message_gutters": {
            "user": {
              "controls": {
                "undo": {
                  "locked": true,
                  "locked_feature": "Undo"
                }
              }
            },
            "agent": {
              "controls": {
                "fork": {
                  "locked": true,
                  "locked_feature": "Fork"
                }
              }
            }
          },
          "active_footer": {
            "chat_pill": {
              "controls": {
                "attach": {
                  "locked": true,
                  "locked_message": "Register to attach files and unlock the full app.",
                  "locked_cta": "Register"
                }
              }
            }
          },
          "idle_footer": {
            "chat_pill": {
              "controls": {
                "attach": {
                  "locked": true,
                  "locked_message": "Register to attach files and unlock the full app.",
                  "locked_cta": "Register"
                }
              }
            }
          },
          "chat_header": {
            "controls": {
              "session_dropdown": {
                "menu": {
                  "content_search": false,
                  "batch_delete": false,
                  "grouping": false
                }
              }
            }
          }
        }
      },
      "free": {},
      "pro": {}
    },
    "admin": {}
  },
  "chat_common": {
    "description": "Shared configuration for every chat surface. Surface profiles inherit this object at runtime, including its messages.",
    "content_max_width": "1000px",
    "transcript_padding": {
      "description": "Additional transcript edge padding in pixels, preserving existing header and composer clearance.",
      "top_px": 100,
      "bottom_px": 100
    },
    "message_bubbles": {
      "description": "Bubble text size and internal padding in pixels. Surface and agent profiles may override individual values; agent left padding controls its text inset independently of user bubbles.",
      "font_size_px": 17,
      "padding_y_px": 10,
      "padding_x_px": 14,
      "agent_padding_left_px": 4,
      "user": {
        "bg_dark": "var(--user-bubble-bg, color-mix(in oklab, var(--bg-elev) 82%, transparent))",
        "bg_light": "var(--user-bubble-bg, color-mix(in oklab, var(--bg-elev) 85%, transparent))",
        "border": "var(--border-width) solid var(--user-bubble-border, color-mix(in oklab, currentColor 12%, transparent))"
      },
      "agent": {
        "bg_dark": "transparent",
        "bg_light": "transparent",
        "border": "none"
      }
    },
    "context_composition": {
      "enabled": true,
      "detailed_segments": true
    },
    "transcript_overscroll": {
      "description": "Vertical transcript pull distance in pixels. The maximum stretch and both top/bottom action triggers always use this same value. Surface profiles may override max_stretch_px.",
      "max_stretch_px": 10
    },
    "transcript_tail_clearance": {
      "description": "Gap in pixels between the newest transcript content and the composer overlay. This is added to the live composer height so the latest message stops above the pill.",
      "gap_px": 74
    },
    "message_visibility": {
      "description": "Independent show/hide per message lane type. These defaults apply when the user has no per-device override; the header filter popover (elements/visibility) writes overrides to localStorage and re-renders the transcript.",
      "defaults": {
        "main": true,
        "progress": true,
        "tool": true,
        "summary": true,
        "system": true
      }
    },
    "user_message_truncation": {
      "description": "Limits long user messages in the transcript while preserving their complete DOM content. Set enabled false to disable, or override max_lines and labels per surface or agent.",
      "enabled": true,
      "max_lines": 3,
      "expand_label": "See more",
      "collapse_label": "Show less"
    },
    "message_gutters": {
      "description": "Configurable footer gutters beneath user and agent messages. Order arrays replace entirely on surface or agent override. A locked control stays visible but displays its locked_message instead of executing. Tier gates are reapplied after agent overrides.",
      "user": {
        "enabled": true,
        "order": [
          "time",
          "full_view",
          "copy",
          "undo",
          "delete",
          "more"
        ],
        "controls": {
          "time": {
            "enabled": true
          },
          "full_view": {
            "enabled": true
          },
          "copy": {
            "enabled": true
          },
          "undo": {
            "enabled": true,
            "locked": false,
            "locked_message": "Sign in to undo messages."
          },
          "delete": {
            "enabled": true
          },
          "more": {
            "enabled": true
          }
        }
      },
      "agent": {
        "enabled": true,
        "order": [
          "time",
          "full_view",
          "collapse",
          "read_aloud",
          "copy",
          "fork",
          "delete",
          "more"
        ],
        "controls": {
          "time": {
            "enabled": true
          },
          "full_view": {
            "enabled": true
          },
          "collapse": {
            "enabled": true
          },
          "read_aloud": {
            "enabled": true
          },
          "copy": {
            "enabled": true
          },
          "fork": {
            "enabled": true,
            "locked": false,
            "locked_message": "Sign in to fork a conversation."
          },
          "delete": {
            "enabled": true
          },
          "schema": {
            "enabled": true
          },
          "more": {
            "enabled": true
          }
        }
      },
      "more_menu": {
        "enabled": true,
        "order": [
          "context",
          "cost",
          "model",
          "message_id",
          "row_details",
          "schema",
          "refresh"
        ],
        "controls": {
          "context": {
            "enabled": true
          },
          "cost": {
            "enabled": true
          },
          "model": {
            "enabled": true
