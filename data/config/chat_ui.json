    "chat_header": {
      "description": "Header layout and controls. Row arrays replace entirely on surface override. Each row has left/center/right zones; 'right' is pushed via margin-left:auto.",
      "enabled": true,
      "max_width": "750px",
      "rows": [
        {
          "left": [],
          "center": [
            "icon",
            "title",
            "status",
            "dot"
          ],
          "right": [
            "visibility",
            "close"
          ]
        }
      ],
      "anchor_navigation": {
        "description": "Compact previous/next user-turn navigation beside the session-resource tabs. Both controls use the canonical transcript user-turn targets, including durable history outside the loaded window.",
        "enabled": true,
        "up_aria_label": "Jump to the previous user message",
        "down_aria_label": "Jump to the next user message"
      },
      "controls": {
        "session_dropdown": {
          "description": "Session selector trigger and menu. Every affordance can be disabled independently; tier_gates may apply a final server-enforced override.",
          "enabled": true,
          "trigger": {
            "agent_icon": true,
            "status": true,
            "row_actions": true,
            "delete": false,
            "rename_on_hold": true
          },
          "menu": {
            "width": "min(420px, calc(100vw - 16px))",
            "max_height": "min(66vh, 640px)",
            "agent_icons": true,
            "status": true,
            "grouping": true,
            "pinning": true,
            "rename": true,
            "auto_rename": true,
            "row_actions": true,
            "open_in_widget": true,
            "start_scratchpad": true,
            "always_on_display": true,
            "delete": true,
            "row_delete": false,
            "agent_id": true,
            "session_id": true,
            "engine_thread_id": true,
            "search": true,
            "content_search": true,
            "recycle_bin": true,
            "hidden_sessions": true,
            "batch_delete": true
          }
        },
        "icon": {
          "container_size": "28px"
        },
        "title": {
          "container_size": "28px"
        },
        "status": {
          "container_size": "28px"
        },
        "dot": {
          "container_size": "28px"
        },
