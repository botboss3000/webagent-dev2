      "row_sizes": {
        "description": "Independent header row sizing, shared by desktop and mobile. primary sizes session controls; tabs sizes chat tabs and navigation. primary.border_radius accepts a CSS length (e.g. 14px) or pill for half the control height. Per-control overrides win; reload after editing.",
        "primary": {
          "container_size": "40px",
          "element_size": "28px",
          "font_size": "18px",
          "border_radius": "pill"
        },
        "tabs": {
          "container_size": "26px",
          "font_size": "12px"
        }
      }
    },
    "component_panel": {
      "description": "Agent component panel \u2014 the single surface for present_chat_component renderings. FULL VIEW is its only open state (CHAT-COMPONENT-FULL-VIEW): a full-height overlay pinned below the chat header tabs and ABOVE the composer (the composer stays visible and usable), as wide as the transcript's content width (chat_common.content_max_width). There is no drawer and no expand control; the header tabs open it and the (\u2014) header button closes it. Components load silently behind the chat pill by default; users open them from their header tabs. Set auto_open_on_present true only for a surface that deliberately needs live presentation. Radius defaults to 12px (structural CSS in app1.css); override with \"radius\" (any CSS length).",
      "enabled": true,
      "auto_open_on_present": false
    },
    "active_footer": {
      "description": "Full-featured footer shown when the textarea is focused or has content.",
      "margin_bottom": "0px",
      "chat_pill": {
        "description": "Shared two-row composer. Row 1: full-width textarea. Row 2: left=attach, center=carousel(stats), right=stop/continue/send.",
        "pill_width": "500px",
        "pill_radius": "41px",
        "rows": [
          {
            "center": {
              "controls": [
                "textarea"
              ]
            }
          },
          {
            "left": {
              "controls": [
                "attach"
              ],
              "align": "bottom",
              "padding": "4px 2px 20px 20px"
            },
            "center": {
              "carousel": [
                "stats"
              ],
              "align": "bottom",
              "padding": "0 0 28px 0"
            },
            "right": {
              "controls": [
                "stop",
                "continue",
                "mic_send"
              ],
              "align": "bottom",
              "padding": "4px 20px 20px 0"
            }
          }
        ],
        "controls": {
          "textarea": {
            "min_height": "88px",
            "font_size": "16px",
            "max_height": "180px",
            "padding": "28px 20px 13px 20px"
          },
          "stats": {
            "description": "Usage stats shown in the pill. visible = ordered list of stat types: ctx (current context only, e.g. 77.2k), ctx-max (full 'ctx 77.2k / 200k' current/max readout), cost (price, e.g. $0.12). Each entry is a plain string or { type, decimals } \u2014 decimals overrides the default (ctx: 1 below 1M, 2 above; cost: 2, rounded up so the first charge reads $0.01). A stat hides itself while its value is zero.",
            "visible": [
              {
                "type": "ctx"
              },
              {
                "type": "cost"
              }
            ]
          },
          "attach": {
            "enabled": true,
            "locked": false,
