{
  "format": "webagent-browser-storage-inventory",
  "version": 1,
  "schema_version": 7,
  "databases": [
    {
      "name_pattern": "webagent_session_db_<tenant_scope>",
      "tenant_scoped": true,
      "encryption": {
        "status": "none",
        "limitation": "Any successful same-origin script can read these values; future at-rest encryption would not mitigate same-origin XSS."
      },
      "stores": [
        {
          "name": "sessions",
          "purpose": "Session metadata and validated server-cache manifests",
          "schema_version": 7,
          "classification": "cache",
          "data_categories": ["session identifiers", "titles", "agent identifiers", "authority revision and content hash"],
          "identifiers": ["id", "agent_id"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "sensitive",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/storage-adapter.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/storage-adapter.js"],
          "sync_destination": "authoritative session backend when browser authority is separately enabled",
          "retention": "validated transcript TTL; browser-authority dirty rows are not silently evicted",
          "quota": "shared max_cache_bytes",
          "export": "JSON",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "authority revision, content hash, schema and policy epoch",
          "migration": "IndexedDB version upgrade; fail closed on unknown schema"
        },
        {
          "name": "interactions",
          "purpose": "Chat turns for browser authority or a validated transcript cache",
          "schema_version": 7,
          "classification": "cache",
          "data_categories": ["message content", "tool protocol rows", "timestamps"],
          "identifiers": ["id", "session_id", "session_seq"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/storage-adapter.js"],
          "sync_destination": "session interaction backend",
          "retention": "transcript TTL for clean cache; tombstones remain in sync_outbox",
          "quota": "shared max_cache_bytes",
          "export": "JSON with recursive secret-field redaction",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "session manifest revision/hash",
          "migration": "IndexedDB version upgrade"
        },
        {
          "name": "agent_config",
          "purpose": "Short-lived allowlisted browser agent configuration",
          "schema_version": 7,
          "classification": "derived",
          "data_categories": ["agent display metadata", "visible tool and ability metadata"],
          "identifiers": ["id", "config_hash"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "moderate",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/indexeddb.js"],
          "readers": ["ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/indexeddb.js"],
          "sync_destination": null,
          "retention": "metadata TTL",
          "quota": "shared max_cache_bytes",
          "export": "JSON with recursive secret-field redaction",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "config hash plus policy epoch",
          "migration": "clear incompatible cached configuration"
        },
        {
          "name": "session_runs",
          "purpose": "Ephemeral turn coordination and partial recovery events",
          "schema_version": 7,
          "classification": "receipt",
          "data_categories": ["turn state", "partial events", "error summaries"],
          "identifiers": ["id", "session_id"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/indexeddb.js"],
          "readers": ["ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/indexeddb.js"],
          "sync_destination": null,
          "retention": "terminal/recovery cleanup; never indefinite",
          "quota": "shared max_cache_bytes",
          "export": "JSON",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "session and policy epoch",
          "migration": "clear incompatible run state"
        },
        {
          "name": "memories",
          "purpose": "User memory pages produced during chat",
          "schema_version": 7,
          "classification": "authority",
          "data_categories": ["memory text", "memory type and slug"],
          "identifiers": ["slug"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/browser-router.js", "ui/chat/js/storage/indexeddb.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js"],
          "sync_destination": "user memory backend when browser authority is approved",
          "retention": "explicit user erasure; not cache-evicted",
          "quota": "authority writes must reserve shared quota",
          "export": "JSON",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "memory revision and policy epoch",
          "migration": "preserve only through reviewed schema migration"
        },
        {
          "name": "genui_pages",
          "purpose": "Generated UI page metadata",
          "schema_version": 7,
          "classification": "derived",
          "data_categories": ["generated titles", "descriptions", "agent identifiers"],
          "identifiers": ["slug"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "sensitive",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "sync_destination": "GenUI backend when configured",
          "retention": "generated-content TTL or explicit erasure",
          "quota": "shared max_cache_bytes",
          "export": "JSON",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "page revision and policy epoch",
          "migration": "IndexedDB version upgrade"
        },
        {
          "name": "genui_html",
          "purpose": "Generated active HTML kept separate from page metadata",
          "schema_version": 7,
          "classification": "derived",
          "data_categories": ["active generated HTML"],
          "identifiers": ["slug"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high/XSS-sensitive",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "sync_destination": "isolated/sandboxed GenUI backend when configured",
          "retention": "short generated-HTML TTL",
          "quota": "shared max_cache_bytes",
          "export": "JSON string, never executed during export",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "page revision and policy epoch",
          "migration": "clear when rendering/sanitizer contract changes"
        },
        {
          "name": "user_files",
          "purpose": "User-created files and binary content",
          "schema_version": 7,
          "classification": "authority",
          "data_categories": ["user file bytes", "filenames", "MIME metadata"],
          "identifiers": ["path", "room"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/browser-router.js"],
          "sync_destination": "user file backend when configured",
          "retention": "explicit erasure; not silently evicted when authoritative",
          "quota": "Blob-byte-accurate shared quota",
          "export": "Blob/ArrayBuffer as base64 with MIME, byte size and SHA-256",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "file revision and policy epoch",
          "migration": "preserve only through reviewed schema migration"
        },
        {
          "name": "sync_outbox",
          "purpose": "Pending mutations, conflicts, and tombstones",
          "schema_version": 7,
          "classification": "receipt",
          "data_categories": ["pending operations", "revision receipts", "tombstones"],
          "identifiers": ["session_id", "mutation_id"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/sync.js"],
          "readers": ["ui/chat/js/storage/indexeddb.js", "ui/chat/js/storage/sync.js"],
          "sync_destination": "browser sync endpoint",
          "retention": "until acknowledged/resolved; tombstone retention after acknowledgement",
          "quota": "reserved durable capacity; never silently evicted",
          "export": "JSON including unresolved conflicts",
          "erasure": "tenant database deletion after server erasure/tombstone completion",
          "logout_purge": true,
          "remote_invalidation": "sync receipt and policy epoch",
          "migration": "must preserve pending operations or fail closed"
        },
        {
          "name": "tool_details",
          "purpose": "Disabled legacy cache for potentially sensitive tool output",
          "schema_version": 7,
          "classification": "derived",
          "data_categories": ["tool arguments and results"],
          "identifiers": ["id"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "very high",
          "secrets_forbidden": true,
          "writers": [],
          "readers": [],
          "sync_destination": null,
          "retention": "writes disabled; legacy rows cleared at schema v5",
          "quota": "zero new bytes",
          "export": "JSON with recursive secret-field redaction if a legacy row remains",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "schema and policy epoch",
          "migration": "clear"
        },
        {
          "name": "app_cache",
          "purpose": "Generic key-value cache — per-entity rows migrated from legacy localStorage blobs (chat focus, manifests, seq cursors, persistence receipts, chat outbox, chat draft) plus UI state",
          "schema_version": 7,
          "classification": "cache",
          "data_categories": ["per-session chat bookkeeping", "UI state", "cursor positions", "recovery receipts"],
          "identifiers": ["key"],
          "tenant_key": "physical database tenant scope",
          "sensitivity": "moderate",
          "secrets_forbidden": true,
          "writers": ["ui/chat/js/storage/kv-cache.js", "ui/chat/js/storage/indexeddb.js"],
          "readers": ["ui/chat/js/storage/kv-cache.js", "ui/chat/js/storage/indexeddb.js"],
          "sync_destination": null,
          "retention": "per-row TTL via by_expiry index; no expiry rows swept only with the tenant database",
          "quota": "shared max_cache_bytes",
          "export": "JSON",
          "erasure": "tenant database deletion",
          "logout_purge": true,
          "remote_invalidation": "policy epoch",
          "migration": "IndexedDB version upgrade; one-time seed from legacy localStorage blobs"
        }
      ]
    },
    {
      "name_pattern": "webagent_attachments_<tenant_scope>",
      "tenant_scoped": true,
      "encryption": {
        "status": "none",
        "limitation": "Same-origin XSS can read Blob values."
      },
      "stores": [
        {
          "name": "attachments",
          "purpose": "Browser attachment bytes and metadata",
          "schema_version": 2,
          "classification": "authority",
          "data_categories": ["raw Blob", "MIME type", "filename", "size", "created time"],
          "identifiers": ["id", "owner_scope"],
          "tenant_key": "physical database tenant scope and owner_scope row field",
          "sensitivity": "high",
          "secrets_forbidden": true,
          "writers": ["ui/shared/js/attachments-idb.js", "ui/shared/js/attachments.js"],
          "readers": ["ui/shared/js/attachments-idb.js", "ui/shared/js/attachments.js"],
          "sync_destination": "attachment backend when configured",
          "retention": "explicit erasure; not silently evicted when authoritative",
          "quota": "actual Blob byte size",
          "export": "Blob as base64 with MIME, byte size and SHA-256",
          "erasure": "tenant attachment database deletion and object URL revocation",
          "logout_purge": true,
          "remote_invalidation": "attachment revision and policy epoch",
          "migration": "scoped database version upgrade"
        }
      ]
    }
  ],
  "legacy_databases": [
    {
      "name": "webagent-attachments",
      "mode": "migration/purge-only",
      "reason": "Legacy rows have no trustworthy tenant key and must never be served as current-tenant data.",
      "export": "forbidden to prevent cross-tenant disclosure",
      "purge": "delete database during tenant lifecycle purge"
    }
  ]
}
